PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/questionnaire
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=questionnaire

# Redis (answer cache + finish queue)
REDIS_URL=redis://localhost:6379

# Finish-queue worker
FINISH_QUEUE_CONCURRENCY=25
FINISH_QUEUE_ATTEMPTS=5
RUN_WORKER=true

# Cache TTLs (seconds)
CACHE_TTL_PARTICIPATION=7200
CACHE_TTL_QUESTION=86400
